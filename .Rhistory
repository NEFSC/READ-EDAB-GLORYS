cat("Starting audit across", length(audit_directories), "directories...\n")
folders_to_fix <- c()
# Iterate through every expected folder ID (1 to 598)
for (i in 1:total_expected) {
folder_name <- paste0(folder_prefix, i)
# Construct full paths for this folder in ALL audit directories
# file.path vectorizes, so this creates a list of paths to check for THIS folder
potential_paths <- file.path(audit_directories, folder_name)
# Check existence in any of the locations
exists_mask <- dir.exists(potential_paths)
if (!any(exists_mask)) {
# CASE 1: Folder exists in NONE of the audit directories
folders_to_fix <- c(folders_to_fix, folder_name)
} else {
# CASE 2: Folder exists in at least one place. Check file counts.
found_paths <- potential_paths[exists_mask]
# Count files in the found locations
counts <- sapply(found_paths, function(p) length(list.files(p)))
# If the BEST count found is still less than minimum, it's incomplete
if (max(counts) < min_file_count) {
folders_to_fix <- c(folders_to_fix, folder_name)
}
}
}
# ==============================================================================
# 4. GENERATE POWERSHELL COMMANDS
# ==============================================================================
if(length(folders_to_fix) > 0){
# Sort numerically
folders_to_fix <- unique(folders_to_fix)
folder_nums <- as.numeric(gsub(folder_prefix, "", folders_to_fix))
folders_to_fix <- folders_to_fix[order(folder_nums)]
}
cat("\n--------------------------------------------------------\n")
cat("AUDIT SUMMARY\n")
cat("--------------------------------------------------------\n")
cat(sprintf("Directories Scanned:      %d\n", length(audit_directories)))
cat(sprintf("Total Expected Runs:      %d\n", total_expected))
cat(sprintf("Missing/Incomplete Runs:  %d\n", length(folders_to_fix)))
if(length(folders_to_fix) == 0) {
cat("\nSUCCESS: Every run was found (with >%d files) in at least one directory.\n", min_file_count)
} else {
cat("\n\n")
cat("=======================================================\n")
cat("COPY THE LINES BELOW INTO YOUR POWERSHELL WINDOW\n")
cat("=======================================================\n\n")
# 1. Define variables
cat(paste0('$RemPath = "', remote_source_dir, '"\n'))
cat(paste0('$LocPath = "', windows_local_dest, '"\n'))
# 2. Create local dir if missing
cat('if (!(Test-Path -Path $LocPath)) { New-Item -ItemType Directory -Force -Path $LocPath | Out-Null }\n\n')
for(folder in folders_to_fix) {
# 3. SCP Command
cmd <- sprintf('scp -r "%s@%s:${RemPath}%s" $LocPath',
remote_user,
remote_host,
folder)
cat(cmd, "\n")
}
cat("\n=======================================================\n")
}
